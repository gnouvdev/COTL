---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import { copy } from './copy';
import TextileArtifact from './components/TextileArtifact.astro';

const { lang } = Astro.props as { lang: keyof typeof copy };
const t = copy[lang];
const viCopy = copy.vi;
const enCopy = copy.en;
const vi = lang === 'vi';
const sections = ['about', 'lands', 'journey', 'gallery', 'team'];
const pdfVi = '/COTL-VIET.pdf?v=2026-11-17';
const pdfEn = '/COTL-ENG.pdf?v=2026-11-25';
const pilotPostUrl = 'https://web.facebook.com/colorsoftheland/posts/pfbid0hCK2wZ3Qa1h9sbSDpHyS9V2Z8nXz1dPsHVjAKtLRG85NuoBXi4RK4dGxckhspitel';
const facebookPageUrl = 'https://web.facebook.com/colorsoftheland';
const landPostUrls: Record<string, string> = {
  'an-giang': facebookPageUrl,
  'long-khanh': facebookPageUrl,
  'xi-thoai': facebookPageUrl,
  'co-tu': facebookPageUrl,
  'lang-teng': facebookPageUrl,
};
const deck = 'https://www.canva.com/design/DAHWBJXd7rw/bSWg5JSgl1Dq7bpKYPIiAw/edit';

const team = [
  { name: 'Thục Đoan', image: 'doan', domainVi: 'truy xuất & di sản', domainEn: 'traceability & heritage', dye: '#1f3a56', dyeSoft: '#eaf0f6', pigmentVi: 'Sắc thổ cẩm làng Teng', pigmentEn: 'Lang Teng Brocade' },
  { name: 'Đình Lợi', image: 'loi', domainVi: 'tài chính & chuỗi giá trị', domainEn: 'finance & value chain', dye: '#91583c', dyeSoft: '#f6ece5', pigmentVi: 'Sắc đất đỏ đại ngàn', pigmentEn: 'Annamite Terracotta' },
  { name: 'Nhật Thành', image: 'thanh', domainVi: 'bút ký & kể chuyện', domainEn: 'editorial storytelling', dye: '#b67b36', dyeSoft: '#f9f1e2', pigmentVi: 'Sắc nghệ Xí Thoại', pigmentEn: 'Xi Thoai Turmeric' },
  { name: 'Quốc Vương', image: 'vuong', domainVi: 'hệ thống & dữ liệu', domainEn: 'systems & data', dye: '#3c6252', dyeSoft: '#ebf2ee', pigmentVi: 'Sắc chỉ dệt Long Khánh', pigmentEn: 'Long Khanh Loom Thread' },
  { name: 'Thục Anh', image: 'anh', domainVi: 'thu mua & thị trường', domainEn: 'supply & markets', dye: '#6b455e', dyeSoft: '#f3ebf0', pigmentVi: 'Sắc Mặc Nưa Tân Châu', pigmentEn: 'Tan Chau Mac Nua' },
];

const heroZones = [
  {
    id: 'an-giang',
    nameVi: 'An Giang',
    nameEn: 'An Giang',
    coords: '10°47\'N · 12m',
    tint: 'rgba(122, 78, 105, 0.34)',
    quoteVi: '“Từng sợi chỉ tơ qua bàn tay nghệ nhân Chăm hòa quyện kỹ thuật thủ công với di sản Nam Bộ.”',
    quoteEn: '“Silk threads guided by Cham artisans intertwine handloom mastery with Southern heritage.”',
  },
  {
    id: 'long-khanh',
    nameVi: 'Đồng Tháp',
    nameEn: 'Dong Thap',
    coords: '10°48\'N · 6m',
    tint: 'rgba(29, 66, 115, 0.34)',
    quoteVi: '“Hơn một thế kỷ nhịp thoi vang bên sông nước, dệt nên từng ô kẻ sọc khăn rằn Long Khánh.”',
    quoteEn: '“Over a century of river-delta shuttle rhythms weaving checkered khăn rằn scarves.”',
  },
  {
    id: 'xi-thoai',
    nameVi: 'Phú Yên',
    nameEn: 'Phu Yen',
    coords: '13°26\'N · 340m',
    tint: 'rgba(194, 136, 71, 0.3)',
    quoteVi: '“Mười hai mô típ hoa văn cổ phục dựng từ ký ức những người bà Ba Na.”',
    quoteEn: '“Twelve ancient sacred motifs revived from the memory of Ba Na matriarchs.”',
  },
  {
    id: 'co-tu',
    nameVi: 'Quảng Nam',
    nameEn: 'Quang Nam',
    coords: '15°52\'N · 620m',
    tint: 'rgba(145, 88, 60, 0.32)',
    quoteVi: '“Từng hạt cườm chì đan trực tiếp vào sợi dọc trên khung dệt lưng đại ngàn.”',
    quoteEn: '“Lead beads woven directly into warp threads on Annamite backstrap looms.”',
  },
  {
    id: 'lang-teng',
    nameVi: 'Quảng Ngãi',
    nameEn: 'Quang Ngai',
    coords: '14°46\'N · 180m',
    tint: 'rgba(139, 38, 38, 0.32)',
    quoteVi: '“Sợi bông tự nhiên nhuộm sắc cây rừng, dệt nên hồn núi Trường Sơn tại Làng Teng.”',
    quoteEn: '“Hand-ginned cotton dyed with forest plants on traditional Hrê looms at Lang Teng.”',
  },
];

const journeyMeta = [
  { stationVi: 'Ga 01 · Pilot', stationEn: 'Stn 01 · Pilot', code: 'COTL-01', photo: '/photos/fieldwork/pilot-8.webp', capVi: 'Đèn ông sao vải in hoa lá', capEn: 'Botanical eco-print lantern', href: '#pilot' },
  { stationVi: 'Ga 02 · Thực địa', stationEn: 'Stn 02 · Fieldwork', code: 'COTL-02', photo: '/photos/fieldwork/weaver-2.webp', capVi: 'Khảo sát chiều sâu 3 cộng đồng', capEn: 'In-depth community fieldwork', href: '#lands' },
  { stationVi: 'Ga 03 · Phân tích', stationEn: 'Stn 03 · Standards', code: 'COTL-03', photo: '/photos/long-khanh.webp', capVi: 'Đối chiếu tiêu chuẩn ngành may', capEn: 'Apparel standards benchmark', href: '#lands' },
  { stationVi: 'Ga 04 · Tham vấn', stationEn: 'Stn 04 · Selection', code: 'COTL-04', photo: '/photos/fieldwork/product-3.webp', capVi: 'Tham vấn & chọn Case Study', capEn: 'Stakeholder validation', href: '#lands' },
  { stationVi: 'Ga 05 · Giải pháp', stationEn: 'Stn 05 · Pilot 2029', code: 'COTL-05', photo: '/photos/lang-teng.webp', capVi: 'Đồng thiết kế giải pháp thực tế', capEn: 'Co-design practical solution', href: '#contact' },
];

const hangStyles = [
  { size: 'size-tall', drop: 'drop-short', tilt: '-1.8deg' },
  { size: 'size-wide', drop: 'drop-deep', tilt: '1.5deg' },
  { size: 'size-polaroid', drop: 'drop-mid', tilt: '-1.1deg' },
  { size: 'size-wide', drop: 'drop-short', tilt: '1.7deg' },
  { size: 'size-tall', drop: 'drop-deep', tilt: '-1.5deg' },
  { size: 'size-polaroid', drop: 'drop-mid', tilt: '1.2deg' },
  { size: 'size-wide', drop: 'drop-short', tilt: '-1.4deg' },
  { size: 'size-polaroid', drop: 'drop-deep', tilt: '1.8deg' },
];
const fieldCaptionVi = 'Lưu trữ thực địa độc lập · Việt Nam 2026';
const fieldCaptionEn = 'Independent fieldwork archive · Vietnam 2026';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={t.intro} />
  <title>{t.title}{vi ? ' | Colors of the Land' : ''}</title>
  <link rel="alternate" hreflang="vi" href="/" />
  <link rel="alternate" hreflang="en" href="/en/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/site.css" />
</head>
<body>
  <a class="skip" href="#main" data-vi={viCopy.skip} data-en={enCopy.skip}>{t.skip}</a>
  <header class="masthead"><div class="shell masthead-inner">
    <a class="brand" href="/">Colors of the Land<span>.</span></a>
    <nav aria-label={vi ? 'Điều hướng chính' : 'Main navigation'}>
      {t.nav.map((label, i) => (
        <a href={'#' + sections[i]} data-vi={viCopy.nav[i]} data-en={enCopy.nav[i]}>{label}</a>
      ))}
    </nav>
    <div class="masthead-actions">
      <a
        class="header-pdf-link"
        href={vi ? pdfVi : pdfEn}
        data-vi-href={pdfVi}
        data-en-href={pdfEn}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        <span data-vi={viCopy.downloadPdf} data-en={enCopy.downloadPdf}>{t.downloadPdf}</span>
      </a>
      <div class="language" role="group" aria-label={vi ? 'Ngôn ngữ' : 'Language'}>
        <a href="/" lang="vi" hreflang="vi" aria-label="Tiếng Việt" aria-current={vi ? 'page' : undefined}>VI</a>
        <a href="/en/" lang="en" hreflang="en" aria-label="English" aria-current={!vi ? 'page' : undefined}>EN</a>
      </div>
    </div>
  </div></header>

  <main id="main" class="story-page">
    <!-- Hero Section: Clean Full-HD Video + 5-Zone Interactive Heritage Horizon -->
    <section class="cover" aria-labelledby="title">
      <figure class="cover-picture">
        <div class="hero-photo">
          <video class="hero-ambient-video" autoplay loop muted playsinline preload="auto" poster="/photos/hero-video-poster.webp?v=2">
            <source src="/videos/section_hero.mp4?v=latest" type="video/mp4" />
            <img src="/photos/hero-video-poster.webp?v=2" width="1280" height="720" alt={t.heroAlt} data-vi-alt={viCopy.heroAlt} data-en-alt={enCopy.heroAlt} />
          </video>
          <div class="hero-horizon-tint" aria-hidden="true"></div>
        </div>
      </figure>

      <div class="hero shell">
        <div class="hero-grid-stage">
          <div class="hero-copy">
            <h1 id="title">
              <span data-vi="Sắc màu" data-en="Colors of">{vi ? 'Sắc màu' : 'Colors of'}</span>{' '}
              <em data-vi="của đất" data-en="the Land">{vi ? 'của đất' : 'the Land'}</em>
            </h1>
            <p class="hero-lead" data-vi={viCopy.lead} data-en={enCopy.lead}>{t.lead}</p>
            <div class="actions">
              <a class="button" href="#about">
                <span data-vi="Bắt đầu chuyến đi" data-en="Begin the journey">{vi ? 'Bắt đầu chuyến đi' : 'Begin the journey'}</span>{' '}
                <span aria-hidden="true">↓</span>
              </a>
              <a class="text-link" href="#contact" data-vi={viCopy.contact} data-en={enCopy.contact}>{t.contact}</a>
            </div>
          </div>

          <!-- Poetic Field Readout that reveals when hovering the 5 Horizon Regions -->
          <aside class="hero-horizon-readout" data-horizon-readout aria-live="polite">
            <div class="readout-line">
              <span class="readout-region" data-horizon-region></span>
              <span class="readout-coords" data-horizon-coords></span>
            </div>
            <p class="readout-quote" data-horizon-quote></p>
          </aside>
        </div>

        <!-- 5-Zone Interactive Horizon Strip -->
        <div class="hero-horizon-bar" role="navigation" aria-label={vi ? 'Năm miền di sản' : 'Five heritage regions'}>
          {heroZones.map((zone, zi) => (
            <button
              type="button"
              class="horizon-zone-btn"
              data-horizon-zone
              data-target={`#land-${zone.id}`}
              data-tint={zone.tint}
              data-coords={zone.coords}
              data-region-vi={zone.nameVi}
              data-region-en={zone.nameEn}
              data-quote-vi={zone.quoteVi}
              data-quote-en={zone.quoteEn}
            >
              <span class="hz-num">0{zi + 1}</span>
              <span class="hz-name" data-vi={zone.nameVi} data-en={zone.nameEn}>{vi ? zone.nameVi : zone.nameEn}</span>
              <span class="hz-coords">{zone.coords}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- The Living Story Stream with Heritage Railway & Locomotive -->
    <div class="story" data-thread-track>
      <!-- Opening Manifesto (Zero AI Kicker) -->
      <section id="about" class="shell about-editorial">
        <span class="thread-stop" data-thread-node aria-hidden="true"></span>
        <div class="manifesto-wrap">
          <h2 class="manifesto-lead" data-vi={viCopy.aboutManifesto} data-en={enCopy.aboutManifesto}>{t.aboutManifesto}</h2>
          <p class="manifesto-body" data-vi={viCopy.about} data-en={enCopy.about}>{t.about}</p>
        </div>

        <div class="heritage-seal" aria-hidden="true">
          <div class="seal-inner">
            <span class="seal-line-1">SẮC MÀU</span>
            <span class="seal-line-2">CỦA ĐẤT</span>
            <span class="seal-line-3">COTL · 2026</span>
          </div>
        </div>
      </section>

      <!-- Brocade Ribbon Divider -->
      <div class="brocade-ribbon-divider" aria-hidden="true">
        <svg viewBox="0 0 1200 24" preserveAspectRatio="none" class="brocade-svg">
          <pattern id="brocade-pattern" width="60" height="24" patternUnits="userSpaceOnUse">
            <path d="M0 12 L15 0 L30 12 L45 0 L60 12 L45 24 L30 12 L15 24 Z" fill="none" stroke="rgba(145, 88, 60, 0.28)" stroke-width="1.2" />
            <circle cx="30" cy="12" r="2.5" fill="rgba(228, 189, 104, 0.45)" />
          </pattern>
          <rect width="1200" height="24" fill="url(#brocade-pattern)" />
        </svg>
      </div>

      <!-- Chapter 1: The Pilot Seed -->
      <section id="pilot" class="shell chapter pilot-chapter">
        <div class="chapter-media pilot-media" data-reveal>
          <figure class="pilot-photo">
            <div class="image-window brush"><img src="/photos/fieldwork/pilot-1.webp" width="1080" height="1080" alt={t.pilotPhotos[0][1]} data-vi-alt={viCopy.pilotPhotos[0][1]} data-en-alt={enCopy.pilotPhotos[0][1]} loading="lazy" /></div>
            <figcaption data-vi={viCopy.pilotPhotos[0][0]} data-en={enCopy.pilotPhotos[0][0]}>{t.pilotPhotos[0][0]}</figcaption>
          </figure>
          <figure class="pilot-photo">
            <div class="image-window brush"><img src="/photos/fieldwork/pilot-3.webp" width="1080" height="1080" alt={t.pilotPhotos[1][1]} data-vi-alt={viCopy.pilotPhotos[1][1]} data-en-alt={enCopy.pilotPhotos[1][1]} loading="lazy" /></div>
            <figcaption data-vi={viCopy.pilotPhotos[1][0]} data-en={enCopy.pilotPhotos[1][0]}>{t.pilotPhotos[1][0]}</figcaption>
          </figure>
          <figure class="pilot-photo pilot-main">
            <div class="image-window brush"><img src="/photos/fieldwork/pilot-8.webp" width="1080" height="1080" alt={t.pilotPhotos[2][1]} data-vi-alt={viCopy.pilotPhotos[2][1]} data-en-alt={enCopy.pilotPhotos[2][1]} loading="lazy" /></div>
            <figcaption data-vi={viCopy.pilotPhotos[2][0]} data-en={enCopy.pilotPhotos[2][0]}>{t.pilotPhotos[2][0]}</figcaption>
          </figure>
        </div>

        <div class="chapter-copy pilot-copy">
          <span class="thread-stop" data-thread-node aria-hidden="true"></span>
          <header class="monograph-chapter-head">
            <h2 class="monograph-title">
              <span data-vi="Hạt mầm" data-en="The First Seed">{vi ? 'Hạt mầm' : 'The First Seed'}</span>
              <em class="monograph-subline" data-vi="từ cỏ cây quanh nhà" data-en="from backyard flora">{vi ? 'từ cỏ cây quanh nhà' : 'from backyard flora'}</em>
            </h2>
            <div class="monograph-folio-row">
              <span class="folio-idx">i.</span>
              <span class="folio-rule" aria-hidden="true"></span>
              <span class="folio-caption" data-vi="Thử nghiệm Trung Thu · 09/2026" data-en="Mid-Autumn Eco-Print · 09/2026">{vi ? 'Thử nghiệm Trung Thu · 09/2026' : 'Mid-Autumn Eco-Print · 09/2026'}</span>
            </div>
          </header>

          <TextileArtifact
            variant="paper"
            theme="pilot"
            lang={lang}
            frontKickerVi="Nhật ký vườn nhà · tháng chín"
            frontKickerEn="Garden field note · september"
            frontTextVi={viCopy.pilotText}
            frontTextEn={enCopy.pilotText}
            item1LabelVi={viCopy.lessons[0][0]}
            item1LabelEn={enCopy.lessons[0][0]}
            item1TextVi={viCopy.lessons[0][1]}
            item1TextEn={enCopy.lessons[0][1]}
            item2LabelVi={viCopy.lessons[1][0]}
            item2LabelEn={enCopy.lessons[1][0]}
            item2TextVi={viCopy.lessons[1][1]}
            item2TextEn={enCopy.lessons[1][1]}
            postHref={pilotPostUrl}
            postLabelVi="Xem bài viết trên Facebook ↗"
            postLabelEn="Read post on Facebook ↗"
            pdfHrefVi={pilotPostUrl}
            pdfHrefEn={pilotPostUrl}
            backLinkLabelVi="Đọc bài viết chi tiết trên Facebook ↗"
            backLinkLabelEn="Read full story on Facebook ↗"
          />
        </div>
      </section>

      <!-- Brocade Ribbon Divider -->
      <div class="brocade-ribbon-divider" aria-hidden="true">
        <svg viewBox="0 0 1200 24" preserveAspectRatio="none" class="brocade-svg">
          <pattern id="brocade-pattern-2" width="60" height="24" patternUnits="userSpaceOnUse">
            <path d="M0 12 L15 0 L30 12 L45 0 L60 12 L45 24 L30 12 L15 24 Z" fill="none" stroke="rgba(43, 88, 118, 0.25)" stroke-width="1.2" />
            <circle cx="30" cy="12" r="2.5" fill="rgba(145, 88, 60, 0.35)" />
          </pattern>
          <rect width="1200" height="24" fill="url(#brocade-pattern-2)" />
        </svg>
      </div>

      <!-- Chapter 2: Editorial Art-Book Opener + Five Lands -->
      <section id="lands" class="lands-stream">
        <div class="shell artbook-opener">
          <span class="thread-stop" data-thread-node aria-hidden="true"></span>
          <h2 class="artbook-display">
            <span class="ab-line">
              <span data-vi="Hành trình" data-en="Journey">{vi ? 'Hành trình' : 'Journey'}</span>
              <em data-vi="qua" data-en="across">{vi ? 'qua' : 'across'}</em>
            </span>
            <span class="ab-line ab-line-indent">
              <em data-vi="Năm" data-en="Five">{vi ? 'Năm' : 'Five'}</em>
              <span data-vi="Vùng Đất" data-en="Lands">{vi ? 'Vùng Đất' : 'Lands'}</span>
            </span>
          </h2>
          <p class="artbook-side-note" data-vi={viCopy.landsIntro} data-en={enCopy.landsIntro}>{t.landsIntro}</p>
        </div>

        {t.lands.map((site, index) => (
          <article id={`land-${site.id}`} class:list={['shell', 'chapter', 'land-chapter', { 'reverse': index % 2 === 1 }]} data-land-theme={site.id}>
            <span class="roman-watermark" aria-hidden="true">{site.roman}</span>

            <figure class="chapter-media" data-reveal>
              <div class="image-window brush">
                <img src={site.image} alt={site.alt} data-vi-alt={viCopy.lands[index].alt} data-en-alt={enCopy.lands[index].alt} loading="lazy" />
              </div>
            </figure>

            <div class="chapter-copy land-copy">
              <span class="thread-stop" data-thread-node aria-hidden="true"></span>

              <header class="monograph-chapter-head">
                <h3 class="monograph-title">
                  <span data-vi={viCopy.lands[index].name.split('—')[0].trim()} data-en={enCopy.lands[index].name.split('—')[0].trim()}>
                    {site.name.split('—')[0].trim()}
                  </span>
                  <em class="monograph-subline" data-vi={viCopy.lands[index].name.split('—')[1]?.trim() || ''} data-en={enCopy.lands[index].name.split('—')[1]?.trim() || ''}>
                    {site.name.split('—')[1]?.trim() || ''}
                  </em>
                </h3>
                <div class="monograph-folio-row">
                  <span class="folio-idx">{site.roman}.</span>
                  <span class="folio-rule" aria-hidden="true"></span>
                  <span class="folio-caption" data-vi={`${viCopy.lands[index].eyebrow} · ${site.coords}`} data-en={`${enCopy.lands[index].eyebrow} · ${site.coords}`}>
                    {site.eyebrow} · {site.coords}
                  </span>
                </div>
              </header>

              <p class="monograph-quote" data-vi={`“${viCopy.lands[index].quote}”`} data-en={`“${enCopy.lands[index].quote}”`}>
                “{site.quote}”
              </p>

              <TextileArtifact
                variant="cloth"
                theme={site.id}
                lang={lang}
                frontKickerVi={viCopy.lands[index].season}
                frontKickerEn={enCopy.lands[index].season}
                frontTextVi={viCopy.lands[index].story}
                frontTextEn={enCopy.lands[index].story}
                swatches={site.swatches.map((sw, si) => ({
                  color: sw.color,
                  nameVi: viCopy.lands[index].swatches[si].name,
                  nameEn: enCopy.lands[index].swatches[si].name,
                  detailVi: viCopy.lands[index].swatches[si].detail,
                  detailEn: enCopy.lands[index].swatches[si].detail,
                }))}
                item1LabelVi={viCopy.lands[index].bottleneckLabel}
                item1LabelEn={enCopy.lands[index].bottleneckLabel}
                item1TextVi={viCopy.lands[index].bottleneck}
                item1TextEn={enCopy.lands[index].bottleneck}
                item2LabelVi={viCopy.lands[index].interventionLabel}
                item2LabelEn={enCopy.lands[index].interventionLabel}
                item2TextVi={viCopy.lands[index].intervention}
                item2TextEn={enCopy.lands[index].intervention}
                pdfHrefVi={landPostUrls[site.id] || facebookPageUrl}
                pdfHrefEn={landPostUrls[site.id] || facebookPageUrl}
                backLinkLabelVi="Đọc sâu hơn trên Facebook COTL ↗"
                backLinkLabelEn="Read deeper on COTL Facebook ↗"
              />
            </div>
          </article>
        ))}
      </section>

      <!-- Chapter 3: Tactile Fabric Loupe -->
      <section id="loupe" class="shell chapter loupe-chapter">
        <div class="chapter-media loupe-stage">
          <figure class="image-window brush loupe-brush-frame">
            <img
              data-loupe-target
              src="/photos/fieldwork/product-1.webp"
              alt={vi ? 'Vải thổ cẩm dệt tay tại cơ sở Mohamad An Giang' : 'Handwoven Cham textile from Mohamad workshop'}
              data-vi-alt="Vải thổ cẩm dệt tay tại cơ sở Mohamad An Giang"
              data-en-alt="Handwoven Cham textile from Mohamad workshop"
              loading="lazy"
            />
